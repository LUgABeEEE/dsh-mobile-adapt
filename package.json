{
  "name": "dsh-adapt-packs",
  "version": "0.3.5",
  "type": "module",
  "description": "Opt-in adaptation packs for the DSH mobile surface (a host-aware 44px touch floor, icon-button width, width reclaim, floating-widget clearance) plus a compatibility list of third-party plugins on a phone.",
  "license": "MIT",
  "scripts": {
    "list": "node tools/cli.mjs list",
    "check": "node tools/check-pack.mjs",
    "prepublishOnly": "node --test && node scripts/check-bundle.mjs",
    "test": "node --test",
    "verify": "node --test && node scripts/check-bundle.mjs && node tools/cli.mjs list",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LUgABeEEE/dsh-adapt-packs.git"
  },
  "bugs": {
    "url": "https://github.com/LUgABeEEE/dsh-adapt-packs/issues"
  },
  "homepage": "https://github.com/LUgABeEEE/dsh-adapt-packs#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-mobile",
    "mobile-ui",
    "accessibility",
    "touch-targets",
    "css",
    "adaptation-packs",
    "dsh-plugin",
    "compatibility-list",
    "mobile-accessibility",
    "cordis"
  ],
  "author": "LUgABeEEE",
  "bin": {
    "dsh-adapt-packs": "tools/cli.mjs",
    "dsh-adapt": "tools/cli.mjs"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "packs/",
    "catalog.json",
    "compat.json",
    "docs/",
    "tools/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
